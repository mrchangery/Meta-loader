<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/rtmpUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="RTMP URL (e.g. rtmp://live.twitch.tv/app)"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/streamKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Stream key"
        android:inputType="textPassword" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Microphone volume (0 = muted)" />

    <SeekBar
        android:id="@+id/micVol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200"
        android:progress="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Game audio volume (0 = muted)" />

    <SeekBar
        android:id="@+id/gameVol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200"
        android:progress="100" />

    <Spinner
        android:id="@+id/quality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start stream" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Idle" />
</LinearLayout>
